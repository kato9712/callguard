; Rendered by entrypoint.py from environment variables. Don't edit inside the container.
[global]
type=global
user_agent=CallGuard
endpoint_identifier_order=ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:@@SIP_PORT@@
local_net=127.0.0.0/8
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16
local_net=100.64.0.0/10
@@EXTERNAL@@

;================ Callcentric (free NY number, inbound only) ================
@@CALLCENTRIC_BEGIN@@
[callcentric]
type=registration
transport=transport-udp
outbound_auth=callcentric_auth
server_uri=sip:sip.callcentric.net
client_uri=sip:@@CC_USER@@@sip.callcentric.net
contact_user=@@CC_USER@@
retry_interval=60
forbidden_retry_interval=600
max_retries=10000
expiration=300
line=yes
endpoint=callcentric

[callcentric_auth]
type=auth
auth_type=userpass
username=@@CC_USER@@
password=@@CC_PASS@@

[callcentric]
type=aor
contact=sip:sip.callcentric.net
qualify_frequency=25

[callcentric]
type=endpoint
transport=transport-udp
context=from-callcentric
disallow=all
allow=ulaw
outbound_auth=callcentric_auth
aors=callcentric
from_domain=sip.callcentric.net
from_user=@@CC_USER@@
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
timers=no

[callcentric-identify]
type=identify
endpoint=callcentric
match=204.11.192.0/22
@@CALLCENTRIC_END@@

;================ Your phone (Linphone over Tailscale) ================
[ly]
type=endpoint
transport=transport-udp
context=from-phone
disallow=all
allow=g722
allow=ulaw
allow=alaw
auth=ly_auth
aors=ly
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[ly_auth]
type=auth
auth_type=userpass
username=@@PHONE_USER@@
password=@@PHONE_PASS@@

[ly]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
